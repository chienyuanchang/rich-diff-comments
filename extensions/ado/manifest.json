{
  "manifest_version": 3,
  "name": "Markdown PR Comments for Azure DevOps",
  "version": "0.0.1",
  "description": "Comment, reply, resolve, and collapse sections directly in Azure DevOps PR Preview (rendered markdown) view.",
  "author": "chienyuanchang",

  "homepage_url": "https://github.com/chienyuanchang/rich-diff-comments",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*/_git/*/pullrequest/*",
        "https://*.visualstudio.com/*/_git/*/pullrequest/*"
      ],
      "js": [
        "src/lib/textMatch.js",
        "src/lib/tableRows.js",
        "src/lib/markdownPreview.js",
        "src/lib/codeBlocks.js",
        "src/lib/lineMap.js",
        "src/adapters/ado.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "world": "MAIN"
    }
  ]
}
